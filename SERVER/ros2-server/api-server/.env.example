# 서버 설정
SERVER_HOST=0.0.0.0
SERVER_PORT=8004

# ROS2 설정
ROS2_NAMESPACE=
ROS2_SERVICE_NAME=lcd_controller/set_display
ROS2_SERVICE_TIMEOUT=2.0

# ROS2 도메인 ID 설정
# 사용 가능한 도메인 ID 목록 (쉼표로 구분)
ROS2_DOMAIN_ID_ALLOWED=11,12,13
# 실제 사용할 도메인 ID (기본값: 13)
ROS2_DOMAIN_ID=13

# IoT Data Server
IOT_DATA_SERVER_URL=http://ec2-54-180-206-205.ap-northeast-2.compute.amazonaws.com

# CORS 설정
CORS_ORIGINS=*

# 로깅
LOG_LEVEL=INFO
DEBUG=false
