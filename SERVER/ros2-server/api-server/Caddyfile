# Caddy 설정 파일
# 자체 서명 인증서 발급 및 적용

# ============================================
# 전역 설정 (반드시 첫 번째에 위치)
# ============================================
{
    # 이메일 (Let's Encrypt 인증서 갱신 알림용 - 향후 사용)
    email your-email@example.com
    
    # 자체 서명 인증서 사용
    local_certs
}

# ============================================
# IP 주소로 접속하는 경우 (개발/테스트용)
# ============================================
# 자체 서명 인증서 사용 (브라우저 경고 발생)

# HTTPS 서버 (모든 호스트 허용)
:443 {
    # 자체 서명 인증서 사용
    tls internal
    
    # 리버스 프록시
    reverse_proxy ros2-api-server:8000 {
        # WebSocket 지원
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        
        # WebSocket 업그레이드 헤더
        header_up Connection {>Connection}
        header_up Upgrade {>Upgrade}
        
        # 헤더 전달
        header_down -Server
    }
}

# HTTP를 HTTPS로 리다이렉트
:80 {
    redir https://{host}{uri} permanent
}

