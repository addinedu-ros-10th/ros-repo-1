# =============================================================================
# 로컬 개발 환경 설정
# =============================================================================

# 기본 애플리케이션 설정
APP_ENV=local
PYTHON_VERSION=3.12
PROJECT_NAME=App Server
API_V1_STR=/api/v1
DEBUG=true

# DB 접속 모드: local_ssh | aws_internal
DB_MODE=local_ssh

# 로컬: SSH 터널로 RDS 접속 (127.0.0.1:15432)
DB_APP_URL=postgresql+asyncpg://svc_dev:IOT_dev_123%21%40%23@host.docker.internal:15432/iot_care
DB_LEGACY_URL=postgresql+asyncpg://svc_dev:IOT_dev_123%21%40%23@host.docker.internal:15432/iot_care

# ML 스키마용 데이터베이스 URL (ML Registry API용)
ML_DB_URL=postgresql+asyncpg://svc_dev:IOT_dev_123%21%40%23@host.docker.internal:15432/iot_care

# SSH 터널 설정 (수동 실행 또는 autossh 사용)
SSH_TUNNEL_ENABLE=true
SSH_TUNNEL_LOCAL_PORT=15432
SSH_TUNNEL_REMOTE_HOST=localhost
SSH_TUNNEL_REMOTE_PORT=5432
SSH_TUNNEL_BASTION_HOST=ec2-52-79-78-247.ap-northeast-2.compute.amazonaws.com
SSH_TUNNEL_USER=ubuntu
SSH_TUNNEL_KEY_PATH=/app/secret/iot_db_key_pair.pem

# Redis (도커)
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Files
FILES_BASE_DIR=/app/data/files
FILES_MAX_SIZE=10485760
FILES_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# GDrive (선택)
GDRIVE_ENABLE=false
GDRIVE_CLIENT_SECRETS=/app/secrets/client_secrets.json
GDRIVE_CREDENTIALS=/app/secrets/credentials.json

# 로깅
LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=/app/logs/app.log

# CORS 설정
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# JWT 설정
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 보안 설정
SECRET_KEY=your-super-secret-key-change-in-production
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
HTTPS_ONLY=false

# API 설정
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# 스케줄러 설정
SCHEDULER_TIMEZONE=Asia/Seoul
SCHEDULER_MAX_WORKERS=10
SCHEDULER_COALESCE=true

# 모니터링 (향후 구현)
PROMETHEUS_ENABLE=false
PROMETHEUS_PORT=9090
GRAFANA_ENABLE=false
GRAFANA_PORT=3000
ELK_STACK_ENABLE=false

# 성능 설정
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_POOL_SIZE=10

# 백업 설정
BACKUP_ENABLE=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# 알림 설정
SLACK_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

NOTIFY_ENABLE=true
NOTIFY_DISPATCH_ENABLE=true
NOTIFY_WS_ENABLE=true

# 테스트 설정
TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_pass@127.0.0.1:15432/test_db
TEST_REDIS_URL=redis://redis:6379/1

# 개발 도구 설정
PYTEST_ADDOPTS=-v --tb=short
BLACK_LINE_LENGTH=88
RUFF_LINE_LENGTH=88
MYPY_STRICT=true
