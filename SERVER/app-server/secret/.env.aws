# =============================================================================
# AWS 환경 설정
# =============================================================================

# 기본 애플리케이션 설정
APP_ENV=aws
PYTHON_VERSION=3.12
PROJECT_NAME=App Server
API_V1_STR=/api/v1
DEBUG=false

# DB 접속 모드: local_ssh | aws_internal
DB_MODE=aws_internal

# AWS RDS 직접 접속
DB_APP_URL=postgresql+asyncpg://svc_dev:IOT_dev_123%21%40%23@<rds-endpoint>:5432/iot_care
DB_LEGACY_URL=postgresql+asyncpg://svc_dev:IOT_dev_123%21%40%23@<rds-endpoint>:5432/iot_care

# ML 스키마용 데이터베이스 URL (ML Registry API용)
ML_DB_URL=postgresql+asyncpg://svc_dev:IOT_dev_123%21%40%23@<rds-endpoint>:5432/iot_care

# SSH 터널 설정 (AWS에서는 비활성화)
SSH_TUNNEL_ENABLE=false
SSH_TUNNEL_LOCAL_PORT=15432
SSH_TUNNEL_REMOTE_HOST=localhost
SSH_TUNNEL_REMOTE_PORT=5432
SSH_TUNNEL_BASTION_HOST=ec2-52-79-78-247.ap-northeast-2.compute.amazonaws.com
SSH_TUNNEL_USER=ubuntu
SSH_TUNNEL_KEY_PATH=/app/secret/iot_db_key_pair.pem

# Redis (AWS ElastiCache)
REDIS_URL=redis://<elasticache-endpoint>:6379/0
REDIS_PASSWORD=<set-redis-password>
REDIS_DB=0

# Files (AWS S3)
FILES_BASE_DIR=s3://your-bucket/files
FILES_MAX_SIZE=52428800
FILES_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain,application/zip,application/x-tar

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<set-strong-password>
ADMIN_EMAIL=admin@example.com

# GDrive (선택)
GDRIVE_ENABLE=false
GDRIVE_CLIENT_SECRETS=/app/secrets/client_secrets.json
GDRIVE_CREDENTIALS=/app/secrets/credentials.json

# 로깅
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=/app/logs/app.log

# CORS 설정
CORS_ORIGINS=["https://yourdomain.com", "https://api.yourdomain.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# JWT 설정
JWT_SECRET_KEY=<set-strong-jwt-secret-key>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 보안 설정
SECRET_KEY=<set-strong-secret-key>
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict
HTTPS_ONLY=true

# API 설정
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# 스케줄러 설정
SCHEDULER_TIMEZONE=Asia/Seoul
SCHEDULER_MAX_WORKERS=20
SCHEDULER_COALESCE=true

# 모니터링
PROMETHEUS_ENABLE=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLE=true
GRAFANA_PORT=3000
ELK_STACK_ENABLE=true

# 성능 설정
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
REDIS_POOL_SIZE=20

# 백업 설정
BACKUP_ENABLE=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# 알림 설정
SLACK_WEBHOOK_URL=<set-slack-webhook-url>
EMAIL_SMTP_HOST=<set-smtp-host>
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=<set-smtp-user>
EMAIL_SMTP_PASSWORD=<set-smtp-password>

# AWS 설정
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=<set-aws-access-key>
AWS_SECRET_ACCESS_KEY=<set-aws-secret-key>
S3_BUCKET_NAME=<set-s3-bucket-name>

# 테스트 설정
TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_pass@127.0.0.1:15432/test_db
TEST_REDIS_URL=redis://redis:6379/1

# 개발 도구 설정
PYTEST_ADDOPTS=-v --tb=short
BLACK_LINE_LENGTH=88
RUFF_LINE_LENGTH=88
MYPY_STRICT=true
