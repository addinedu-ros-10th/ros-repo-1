<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="pinky_factory">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu">
    </plugin>
    
    <!--light-->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 6 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>1 1 1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>1</constant>
        <linear>0</linear>
        <quadratic>0</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
    </light>
    
    <model name="logo">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="logo_link">
        <visual name="logo_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 3</size>
            </plane>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
            <pbr>
              <metal>
                <albedo_map>file://img/pinklab_half.jpg</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="logo_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 2</size>
            </plane>
          </geometry>
          <surface>
            <contact>
              <collide_without_contact>true</collide_without_contact>
            </contact>
          </surface>
        </collision>
      </link>
    </model>


    <!-- ===== 외벽 4면 ===== -->

    <!-- Wall 1: 남쪽 벽 -->
    <model name="wall_1">
      <static>true</static>
      <pose>1.7215 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.443 0.03 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.443 0.03 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall 2: 동쪽 벽 -->
    <model name="wall_2">
      <static>true</static>
      <pose>3.443 1.125 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.03 2.25 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.03 2.25 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall 3: 북쪽 벽 -->
    <model name="wall_3">
      <static>true</static>
      <pose>1.7215 2.25 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.443 0.03 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.443 0.03 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall 4: 서쪽 벽 -->
    <model name="wall_4">
      <static>true</static>
      <pose>0 1.125 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.03 2.25 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.03 2.25 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!-- 0,0 좌표 시각화용 XYZ 화살표 -->
    <model name="origin_axes">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <!-- X축 (빨강) -->
        <visual name="x_axis">
          <pose>0.225 0 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.45 0.04 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <!-- Y축 (초록) -->
        <visual name="y_axis">
          <pose>0 0.225 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.04 0.45 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <!-- Z축 (파랑) -->
        <visual name="z_axis">
          <pose>0 0 0.225 0 0 0</pose>
          <geometry>
            <box>
              <size>0.04 0.04 0.45</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 내부 벽 -->
    <!-- ===== 내부 벽 구조 ===== -->

    <!-- Inner Wall 1 : 보안출입구 - 응접실 사이 벽 (1)-->
    <model name="wall_inner_1">
      <static>true</static>
      <pose>0.05 1.35 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 0.03 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 0.03 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!-- Inner Wall 2 : 보안출입구 - 응접실 사이 벽 (2)-->
    <model name="wall_inner_2">
      <static>true</static>
      <pose>0.4 1.35 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 0.03 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 0.03 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Inner Wall 3 : 응접실 - 식당 사이 벽 -->
    <model name="wall_inner_3">
      <static>true</static>
      <pose>0.45 0.7875 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.03 1.575 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.03 1.575 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Inner Wall 4 : 식당 - 공용공간 사이 벽 (1)-->
    <model name="wall_inner_4">
      <static>true</static>
      <pose>0.5525 1.575 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.225 0.03 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.225 0.03 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Inner Wall 5 : 식당 - 공용공간 사이 벽 (1)-->
    <model name="wall_inner_5">
      <static>true</static>
      <pose>2.409 1.575 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.068 0.03 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.068 0.03 0.3</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>    



  <model name="camera">
    <static>true</static>
      <pose>0 0 1.6 0 1.57 1.57</pose>
      <link name="link">
        <pose>0.05 0.05 0.05 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.000166667</ixx>
            <iyy>0.000166667</iyy>
            <izz>0.000166667</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </collision>
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>2.094</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>camera</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>